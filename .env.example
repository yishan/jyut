# Copy to .env.local for local development, and set the same variable in your
# hosting provider (Vercel: Project Settings → Environment Variables).
#
# Get a key at https://platform.deepseek.com/api_keys
# Only /api/translate reads this. Jyutping annotation needs no key and runs
# entirely in the browser.
DEEPSEEK_API_KEY=

# Optional. Defaults to https://api.deepseek.com — override to go through a
# proxy, or to point the route at a local mock server when testing.
# DEEPSEEK_BASE_URL=
